# Copy to .env and fill in. Read two ways, from the same file: docker compose
# substitutes these into docker-compose.yml, and service.py and main.py both
# load it directly when run outside a container.

# platform.deepseek.com -> API keys. Needed only to translate: the detection,
# cleaning, OCR and lettering stages all run without one, so `-s ocr` and the
# debug translator below work on an empty key.
DEEPSEEK_API_KEY=

# Which translator the service uses.
#   deepseek  the real one, needs the key above
#   debug     letters a fixed string into every bubble and needs no key --
#             how to check detection, cleaning and lettering on their own
TRANSLATOR=deepseek

# What to translate into. The drawer letters left-to-right, so a language that
# does not read that way will not come out well.
TARGET_LANG=en

# What to assume a chapter is in when whoever submitted it did not say. It
# picks the prompt: `ja` reads the pages as manga, `zh` as manhua, with
# different rules for names, honorifics and set phrases. A caller that knows --
# a library holding the book's own LanguageISO -- sends it per job instead.
#
# The OCR reads both, Japanese best: that is what it was finetuned on, and
# Chinese is what the model it was finetuned from already knew.
SOURCE_LANG=ja

# Port the job API listens on.
PORT=1007

# Scratch for the chapter in flight: unpacked, lettered, packed again. Cleared
# at startup, since a job from a dead process has no record left to collect it.
JOB_DIR=/jobs

# Where the weights are cached. All four models are fetched from the Hugging
# Face hub on first use, about 5 GB in total, and this is a volume in the
# compose file so that rebuilding the image does not fetch them again.
HF_HOME=/cache/huggingface
